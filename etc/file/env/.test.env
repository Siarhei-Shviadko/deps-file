ENV=testing

# Database
DATABASE_HOST=test-database
DATABASE_PORT=5432
DATABASE_DB=test_deps
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
TESTING=true
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

GROUP_URL=http://deps-groups:8000
FILE_STORAGE_URL=http://deps-file-storage-nginx:8000
DOCUMENT_URL=http://deps-document-api:8000
FILES_BATCH_URL=http://deps-files-batch:8000

SENTRY_ENABLED=False
SENTRY_DSN=

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@test-rabbitmq:5672/test_deps

# kafka
KAFKA_GROUP_ID=file

# Auth
AUTH_VERIFY_SSL=false

ASB_SUBSCRIPTION_NAME=file

# Object storage
# aws azure gcp file-storage
OBJECT_STORAGE_TYPE=aws
OBJECT_STORAGE_MODE=sync

# aws
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=

# azure
AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# gcp
GCP_BLOB_STORAGE_BUCKET_NAME=
GCP_BLOB_STORAGE_AUTH_KEY=
